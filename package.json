{
  "name": "digital-gram-panchayat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Digital Gram Panchayat — citizen services platform (Grampanchayat Sakharale). MERN monorepo: citizen PWA, admin portal, backend API, shared package. JavaScript (ES Modules).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "frontend/*",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n BACKEND,CITIZEN,ADMIN -c blue,green,magenta \"npm run dev -w backend\" \"npm run dev -w frontend/citizen-pwa\" \"npm run dev -w frontend/admin-portal\"",
    "dev:server": "npm run dev -w backend",
    "dev:citizen": "npm run dev -w frontend/citizen-pwa",
    "dev:admin": "npm run dev -w frontend/admin-portal",
    "build": "npm run build -w frontend/citizen-pwa && npm run build -w frontend/admin-portal",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "clean": "npm run clean --workspaces --if-present",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e/report"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
