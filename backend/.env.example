# Copy to .env and fill in real values. Never commit .env.
# Boot fails fast if a required variable is missing/invalid — see src/config/env.ts.

# ---- App ----
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ---- Database ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digital_gram_panchayat?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRY_CITIZEN=24h
JWT_EXPIRY_OFFICER=8h

# ---- CORS (frontend origins allowed to call this API) ----
CORS_ORIGIN_CITIZEN=http://localhost:5173
CORS_ORIGIN_ADMIN=http://localhost:5174

# ---- Cloudinary (complaint photos, notice attachments, dakhala PDFs) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Notifications (SMS/voice) ----
# SMS_PROVIDER: mock (logs only, default for local dev) | twilio | msg91
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_API_KEY=
MSG91_SENDER_ID=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Logging ----
# LOG_LEVEL: fatal|error|warn|info|debug|trace
LOG_LEVEL=info
