        "q": "Can I use the app without internet?",
        "a": "Yes. Notices, schemes, tax and your profile are saved for offline reading, and complaints filed offline are sent automatically when you reconnect."
      },
      "complaint": {
        "q": "How do I file a complaint?",
        "a": "Open Complaints, tap New, choose a category, describe the issue and optionally add photos and your location, then submit."
      },
      "language": {
        "q": "How do I change the language?",
        "a": "Choose Marathi or English here in Settings, or use the language button in the top bar."
      },
      "install": {
        "q": "How do I install the app?",
        "a": "When prompted, tap Install to add DGP to your home screen for quick, app-like access."
      }
    }
